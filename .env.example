# Copy to `.env` (repo root) on each machine. Never commit `.env`.
# Generate APP_ENCRYPTION_KEYS and JWT_SECRET per machine:
#   cd backend && uv run python scripts/gen_keys.py

# --- Database / vector DB (docker compose) ---
DATABASE_URL=postgresql+asyncpg://law:law@localhost:5432/law
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=legal_chunks          # with EMBEDDING_BACKEND=fake use legal_chunks_fake

# --- Secrets ---
APP_ENCRYPTION_KEYS=                    # MultiFernet, comma separated; first key encrypts, older keys only decrypt
JWT_SECRET=
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14
COOKIE_SECURE=false                     # true behind HTTPS

# --- Embedding ---
EMBEDDING_BACKEND=bge                   # bge | fake (fake: tests / UI work, no torch)
EMBEDDING_MODEL=BAAI/bge-m3
HF_HOME=                                # optional: HuggingFace model cache dir (~2.3 GB)

# --- Storage ---
UPLOAD_DIR=storage/uploads              # relative paths are resolved against backend/

# --- RAG ---
RAG_TOP_K=8
RAG_MIN_SCORE=0.3                       # tuned after the eval set (T25)

# --- Crawler ---
CRAWLER_RATE_LIMIT_RPS=1                # max 1 request/second to vbpl.vn
CRAWLER_USER_AGENT=LawChatbot/0.1 (+contact email)
CRAWLER_CACHE=false                     # dev: cache raw vbpl.vn responses in CRAWLER_CACHE_DIR
CRAWLER_CACHE_DIR=storage/crawl_cache   # relative to backend/
TZ_APP=Asia/Ho_Chi_Minh
SCHEDULER_ENABLED=false                 # default off; only ONE machine runs the daily crawl (Mac block opts in)

# --- Machine specific: keep ONE block uncommented ---

# --- Mac (Apple Silicon, MPS) ---
EMBEDDING_DEVICE=auto                   # auto -> mps
EMBEDDING_BATCH_SIZE=16                 # 16-32
EMBEDDING_THREADS=                      # empty = torch default
PYTORCH_ENABLE_MPS_FALLBACK=1           # unsupported MPS ops fall back to CPU
SCHEDULER_ENABLED=true                  # Mac opts in: only ONE machine runs the daily crawl

# --- Linux (no GPU) ---
# EMBEDDING_DEVICE=cpu
# EMBEDDING_BATCH_SIZE=8                # 4-8
# EMBEDDING_THREADS=8                   # number of physical cores
# PYTORCH_ENABLE_MPS_FALLBACK=1         # no effect on Linux
